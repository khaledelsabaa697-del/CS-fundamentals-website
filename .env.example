# Supabase (Project Settings -> API)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR-ANON-KEY
# SERVER ONLY. Never prefix with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=YOUR-SERVICE-ROLE-KEY

# AI Grading Provider (server only). OpenAI-compatible API (e.g., Kilo, OpenAI, Azure, etc.)
# Leave AI_API_KEY empty to grade manually.
AI_API_KEY=
AI_BASE_URL=https://api.openai.com/v1
AI_MODEL=gpt-4o-mini
# Development only: deterministic fake grader when the key above is empty.
AI_MOCK=0

# Legacy Gemini (deprecated, will be removed)
# GEMINI_API_KEY=
# GEMINI_MODEL=gemini-2.5-flash
# GEMINI_MOCK=0

# Seed script only (npm run seed)
SEED_ADMIN_PASSWORD=ChangeMe123!
SEED_STUDENT_PASSWORD=Student123!

# Cloudflare Turnstile (CAPTCHA) - optional in dev, required in production
# Get keys from https://dash.cloudflare.com/ -> Turnstile
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Absolute URL for OTP/resend redirects (used by signup and resend-otp)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
